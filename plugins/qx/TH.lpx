#!name = 途虎养车净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：营销弹窗、横幅、超级会员与搜索热词
#!author = dranklim,ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/tuhu.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 营销弹窗与活动方案（mkt-scene-marketing-service）
#   · 首页 banner 与门店 Tab 横幅
#   · 超级会员推广配置（getAutoSuperConfig）
#   · 圈子推荐、搜索热词与商品推荐位
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 TH.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/TH.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https:\/\/mkt-gateway\.tuhu\.cn\/mkt-scene-marketing-service\/api\/scene\/queryScheme/ then reject_dict(200)
request if ${url} ~= /^https:\/\/mkt-gateway\.tuhu\.cn\/mkt-push-message-box\/banner\/cms\/getIndexBanner/ then reject_dict(200)
request if ${url} ~= /^https:\/\/cl-gateway\.tuhu\.cn\/cl-common-api\/api\/personalCenter\/getAutoSuperConfig/ then reject_dict(200)
request if ${url} ~= /^https:\/\/mkt-gateway\.tuhu\.cn\/mkt-cms\/circle\/recommend\/v3/ then reject_dict(200)
request if ${url} ~= /^https:\/\/mkt-gateway\.tuhu\.cn\/mlp-product-search-api\/search\/helper\/defaultAndHotWord/ then reject_dict(200)
response if ${url} ~= /^https:\/\/cl-gateway\.tuhu\.cn\/cl-shop-api\/shopTab\/getModuleForC/ then response.json.jq(`del(.data.bannersList) | .data.cmsList |= map(select(.bottomMargin != 12))`)
response if ${url} ~= /^https:\/\/cl-gateway\.tuhu\.cn\/cl-common-api\/api\/personalCenter\/getCmsModuleList/ then response.json.jq(`.data.cmsList |= map(select(.moduleTypeId != 90 and .moduleTypeId != 17 and .moduleTypeId != 13 and .moduleTypeId != 35 and .moduleTypeId != 10 and .moduleTypeId != 7 and .mainTitle != "保养超值卡" and .mainTitle != "特价团购" and .mainTitle != "合作加盟" and .mainTitle != "抖音团购券兑换" and .mainTitle != "集团客户" and .mainTitle != "美团兑换" and .mainTitle != "评价途虎"))`)

[Mitm]
hostname = mkt-gateway.tuhu.cn, cl-gateway.tuhu.cn

