#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
request if ${url} ~= /^https?:\/\/mobile-stream\.api\.mgtv\.com\/v1\/video\/source/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/mgtv_vip.js")

[Mitm]
hostname = mobile-stream.api.mgtv.com

