#!name = YouTube字幕
#!desc = 参考 ZenmoFeiShi 的去广告脚本：字幕接口解锁
#!author = dranklim, ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/youtube.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 解锁 YouTube 字幕接口（timedtext）的中文字幕请求
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 Yt-zh.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/Yt-zh.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
request if ${url} ~= /^https://www\.youtube\.com/api/timedtext\?.*_ytzhsub=1/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/yt-sub-clean.js")
response if ${url} ~= /^https://www\.youtube\.com/api/timedtext\?/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/yt-zh-sub.js") with requires_body=true

[Mitm]
hostname = www.youtube.com

