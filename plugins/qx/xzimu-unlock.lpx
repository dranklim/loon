# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/user\/updateStatus/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/xzimu-unlock.js") with requires_body=true
request if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/xzimu-unlock.js") with requires_body=true
response if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/xzimu-unlock.js") with requires_body=true
request if ${url} ~= /^http:\/\/47\.251\.39\.178:18080\/task\/runSegment/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/xzimu-unlock.js") with requires_body=true

[Mitm]
hostname = apps.tltgame.com,47.251.39.178

