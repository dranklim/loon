#!name = 字幕解锁
#!desc = 参考 ZenmoFeiShi 的去广告脚本：字幕任务会员校验解除
#!author = dranklim,ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/xzimu.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 解除字幕识别任务的会员状态校验（updateStatus）
#   · 绕过任务离线限制与分段识别接口鉴权
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 xzimu-unlock.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/xzimu-unlock.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/user\/updateStatus/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/xzimu-unlock.js") with requires_body=true
request if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/xzimu-unlock.js") with requires_body=true
response if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/xzimu-unlock.js") with requires_body=true
request if ${url} ~= /^http:\/\/47\.251\.39\.178:18080\/task\/runSegment/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/xzimu-unlock.js") with requires_body=true

[Mitm]
hostname = apps.tltgame.com,47.251.39.178

