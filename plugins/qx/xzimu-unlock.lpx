#!name = 字幕解锁（QX 迁移）
#!desc = 由 ZenmoFeiShi/Qx 的 xzimu-unlock.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 0 条重写 + 4 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/xzimu.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = QX迁移,去广告
#!type = normal

