#!name = 美团净化
#!desc = 由 ZenmoFeiShi/Qx 的 MT.snippet 转换为 Loon Rewrite/Script v2 语法（46 条规则 + 2 条重写 + 8 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/meituan.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 MT.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/MT.snippet
#   原作者：TG@ZenMoFiShi / 怎么肥事（以 snippet 头部 #!author 为准）
#   该仓库未声明 LICENSE，版权归原作者；本插件仅做 QuantumultX → Loon 语法转换，
#   脚本镜像至本仓库 scripts/qx/ 以便国内直连。原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游 snippet 与脚本的 sha256
# ==========================================================================

# 域名 / IP 层拦截（来自 QX host / ip-cidr 规则）
[Rule]
DOMAIN,shark-mt.meituan.com,REJECT
DOMAIN,shark-default.meituan.com,REJECT
DOMAIN,shark-dp.meituan.com,REJECT
DOMAIN,shark-ps.meituan.com,REJECT
DOMAIN,shark-wm.sankuai.com,REJECT
DOMAIN,shark.dianping.com,REJECT
DOMAIN-WILDCARD,mquic-*.meituan.com,REJECT
DOMAIN,httpdnsmultiapi.meituan.com,REJECT
DOMAIN,httpdnsmultiapivip.meituan.com,REJECT
DOMAIN,httpdns.meituan.com,REJECT
DOMAIN,httpdnsvip.meituan.com,REJECT
DOMAIN,dnspod.meituan.httpdns.qcloud.com,REJECT
DOMAIN,dnspod.meituan.httpdns.start.qcloud.com,REJECT
IP-CIDR,202.90.108.13/32,REJECT
IP-CIDR,202.90.110.46/32,REJECT
IP-CIDR,202.90.108.69/32,REJECT
IP-CIDR,202.90.110.45/32,REJECT
IP-CIDR,202.90.108.68/32,REJECT
IP-CIDR,202.90.110.48/32,REJECT
IP-CIDR,202.90.108.67/32,REJECT
IP-CIDR,202.90.110.36/32,REJECT
IP-CIDR,202.90.108.54/32,REJECT
IP-CIDR,202.90.108.55/32,REJECT
IP-CIDR,203.76.217.51/32,REJECT
IP-CIDR,203.76.217.53/32,REJECT
IP-CIDR,203.76.217.241/32,REJECT
IP-CIDR,203.76.217.243/32,REJECT
IP-CIDR,103.202.146.30/32,REJECT
IP-CIDR,103.202.146.49/32,REJECT
IP-CIDR,101.50.8.64/32,REJECT
IP-CIDR,103.63.160.64/32,REJECT
IP-CIDR,103.63.160.69/32,REJECT
IP-CIDR,103.37.155.77/32,REJECT
IP-CIDR,103.37.155.60/32,REJECT
IP-CIDR,111.230.0.200/32,REJECT
IP-CIDR,139.9.47.231/32,REJECT
IP-CIDR,121.37.4.167/32,REJECT
IP-CIDR,119.29.126.219/32,REJECT
IP-CIDR,106.55.217.56/32,REJECT
IP-CIDR,103.37.152.224/32,REJECT
IP-CIDR,119.29.48.215/32,REJECT
IP-CIDR,42.193.128.160/32,REJECT
IP-CIDR6,2405:1480:3000:303b::303b/128,REJECT
IP-CIDR6,2405:1480:1000:3::1e/128,REJECT
IP-CIDR6,2405:1480:1000:4::15/128,REJECT
IP-CIDR6,2402:4e00:40:40::2:373/128,REJECT

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https?:\/\/(httpdns|httpdnsvip|httpdnsmultiapi|httpdnsmultiapivip)\.meituan\.com\// then reject(404)
request if ${url} ~= /^http:\/\/103\.37\.155\.60\/fetch/ then reject(404)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true
response if ${url} ~= /^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(gwc_feed1_2265|personalcenter_2154)(\?|$)/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true
response if ${url} ~= /^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true
response if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true
response if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\// then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true
response if ${url} ~= /^https?:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true
response if ${url} ~= /^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true
response if ${url} ~= /^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MT.js") with requires_body=true

[Mitm]
hostname = apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com, httpdns.meituan.com, httpdnsmultiapi.meituan.com

