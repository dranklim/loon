#!name = 腾讯视频 去广告
#!desc = 由 ZenmoFeiShi/Qx 的 TxvideoAD.snippet 转换为 Loon Rewrite/Script v2 语法（2 条规则 + 0 条重写 + 5 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/txvideo.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 TxvideoAD.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/TxvideoAD.snippet
#   原作者：TG@ZenMoFiShi / 怎么肥事（以 snippet 头部 #!author 为准）
#   该仓库未声明 LICENSE，版权归原作者；本插件仅做 QuantumultX → Loon 语法转换，
#   脚本镜像至本仓库 scripts/qx/ 以便国内直连。原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游 snippet 与脚本的 sha256
# ==========================================================================

# 域名 / IP 层拦截（来自 QX host / ip-cidr 规则）
[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
request if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/Txvideoad.js") with requires_body=true

[Mitm]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com

