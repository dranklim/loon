#!name = 腾讯视频净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：广告 SDK 配置编排
#!author = dranklim,ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/txvideo.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 广告 SDK 配置接口（rdelivery.qq.com/v1/sdkconfig），阻断后客户端拿不到广告编排
#   · 会员入口与会员专区模块（vip_entrance）
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 TxvideoAD.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/TxvideoAD.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# 域名 / IP 层拦截（来自 QX host / ip-cidr 规则）
[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
request if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/Txvideoad.js") with requires_body=true
response if ${url} ~= /^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/Txvideoad.js") with requires_body=true

[Mitm]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com

