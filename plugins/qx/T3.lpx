#!name = T3出行 去广告（QX 迁移）
#!desc = 由 ZenmoFeiShi/Qx 的 T3.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 16 条重写 + 0 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/t3.png
#!system = iOS,iPadOS
