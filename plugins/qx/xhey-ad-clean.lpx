#!name = 小红书净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：开屏、第三方广告 SDK 与竞价请求
#!author = dranklim,ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/xiaohongshu.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 开屏与推广广告（ad.xhey.top/next）
#   · 今日水印相机的全局广告开关（abtest 下发）
#   · TopOn / AnyThink 广告 SDK（anythinktech、toponadss）
#   · 百度 mobads、快手广告（open.e.kuaishou）
#   · 第三方 ADX 竞价（1rtb、statisticslinks）
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 xhey-ad-clean.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/xhey-ad-clean.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https?:\/\/(?:api|da|tk|adx)\.anythinktech\.com\// then reject(404)
request if ${url} ~= /^https?:\/\/api\.toponadss\.com\// then reject(404)
request if ${url} ~= /^https?:\/\/mobads(?:-logs)?\.baidu\.com\// then reject(404)
request if ${url} ~= /^https?:\/\/mobads-pre-config\.(?:bj|cdn)\.bcebos\.com\// then reject(404)
request if ${url} ~= /^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\// then reject(404)
request if ${url} ~= /^https?:\/\/stage2\.chelaile\.net\.cn\/sdk/ then reject(404)
request if ${url} ~= /^https?:\/\/ad\.xhey\.top\/next\/(?:app\/adx\/|promote\/operation\/appstart\/adx\/|ad\/event\/track\/).*/ then reject(404)
request if ${url} ~= /^https?:\/\/39\.108\.85\.131\/next\/(?:ios\/config\/cache|promote\/operation\/config\/get\/cache)(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/sdk\.1rtb\.net\/sdk\/(?:config\/v2a|req_ad)(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/adx-strategy-api-cn\.statisticslinks\.com\/sdk\/pl_strategy(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/adx-micro\.statisticslinks\.com\/http_bid(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/da\.statisticslinks\.com\/v1\/open\/da(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/tk\.statisticslinks\.com\/v2\/open\/a_tk(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/sdkquic\.e\.qq\.com\/launch(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/als\.baidu\.com\/clog\/glog(?:\?.*)?$/ then reject(404)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https?:\/\/abtest-tx-beijing-01\.saas\.sensorsdata\.cn\/api\/v2\/abtest\/online\/results\?project-key=(?:0E6053C30A799D63EFA48959776B2EE2EDC81359|EE39C73914ED208E6EBE24A7333CAF5C3FE2E89D)/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/xhey-ad-clean.js") with requires_body=true
response if ${url} ~= /^https?:\/\/jt-sdk-ios\.oss-cn-beijing\.aliyuncs\.com\/iOSConfig\.txt(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/xhey-ad-clean.js") with requires_body=true

[Mitm]
hostname = abtest-tx-beijing-01.saas.sensorsdata.cn, api.anythinktech.com, da.anythinktech.com, tk.anythinktech.com, adx.anythinktech.com, api.toponadss.com, mobads.baidu.com, mobads-logs.baidu.com, mobads-pre-config.bj.bcebos.com, mobads-pre-config.cdn.bcebos.com, open.e.kuaishou.com, open.e.kuaishou.cn, stage2.chelaile.net.cn, ad.xhey.top, 39.108.85.131, sdk.1rtb.net, adx-strategy-api-cn.statisticslinks.com, adx-micro.statisticslinks.com, da.statisticslinks.com, tk.statisticslinks.com, sdkquic.e.qq.com, als.baidu.com, jt-sdk-ios.oss-cn-beijing.aliyuncs.com

