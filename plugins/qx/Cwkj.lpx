#!name = 菜鸟裹裹净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：内嵌游戏中心的等级与 VIP 标识
#!author = dranklim,ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/cainiao.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 菜鸟裹裹内嵌游戏中心（play.wo1wan.com）的等级与 VIP 字段改为满级
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 Cwkj.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/Cwkj.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
response if ${url} ~= /^https:\/\/play\.wo1wan\.com\/nextgame\/igwuser\/userinfo/ then response.json.jq(`.info.LevelInfo.Level = 999 | .info.LevelInfo.VipLevel = 8 | .info.LevelInfo.Svip = 8 | .info.LevelInfo.VipExpires = "2099-01-01T00:00:00Z" | .info.LevelInfo.SVipExpires = "2099-01-01T00:00:00Z"`)
response if ${url} ~= /^https:\/\/play\.wo1wan\.com\/nextgame\/igwuser\/useropeninfo/ then response.json.jq(`.data.LevelInfo.Level = 999 | .data.LevelInfo.VipLevel = 8 | .data.LevelInfo.Svip = 8 | .data.LevelInfo.VipExpires = "2099-01-01T00:00:00Z" | .data.LevelInfo.SVipExpires = "2099-01-01T00:00:00Z"`)

[Mitm]
hostname = play.wo1wan.com

