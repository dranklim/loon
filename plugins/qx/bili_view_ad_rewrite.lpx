#!name = 哔哩哔哩净化
#!desc = 由 ZenmoFeiShi/Qx 的 bili_view_ad_rewrite.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 5 条重写 + 5 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/bilibili.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 bili_view_ad_rewrite.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/bili_view_ad_rewrite.snippet
#   原作者：TG@ZenMoFiShi / 怎么肥事（以 snippet 头部 #!author 为准）
#   该仓库未声明 LICENSE，版权归原作者；本插件仅做 QuantumultX → Loon 语法转换，
#   脚本镜像至本仓库 scripts/qx/ 以便国内直连。原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游 snippet 与脚本的 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https:\/\/cm\.bilibili\.com\/cm\/api\/(conversion|fees)\// then reject_dict(200)
request if ${url} ~= /^https:\/\/dataflow\.biliapi\.com\/log\/pbmobile\// then reject(200)
request if ${url} ~= /^https:\/\/api-pt\.chuangyuejoy\.com\/ad\// then reject_dict(200)
response if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/vip\/window\/list\?/ then response.json.jq(`.data.list = []`)
response if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/vip\/web\/vip_center\/(v2|modules)/ then response.json.jq(`.data.benefits = [] | .data.welfare = null | .data.free_welfare = null | .data.draw_cards_welfare = null | .data.draw_cards_welfare_v2 = null`)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.viewunite\.v1\.View\/View$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.show\.v1\.Popular\/Index$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/bili_view_ad.js") with requires_body=true

[Mitm]
hostname = *bili*,api-pt.chuangyuejoy.com

