#!name = 哔哩哔哩净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：开屏、播放器广告、搜索热词与动态推广
#!author = dranklim, ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/bilibili.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 开屏与播放页广告（View/View、PlayViewUnite）
#   · 搜索默认词与热词推荐（Search/DefaultWords）
#   · 热门页与动态页推广卡片（Popular/Index、DynAll）
#   · 广告转化与投放统计（cm.bilibili.com）
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 bili_view_ad_rewrite.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/bili_view_ad_rewrite.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https:\/\/cm\.bilibili\.com\/cm\/api\/(conversion|fees)\// then reject_dict(200)
request if ${url} ~= /^https:\/\/dataflow\.biliapi\.com\/log\/pbmobile\// then reject(200)
request if ${url} ~= /^https:\/\/api-pt\.chuangyuejoy\.com\/ad\// then reject_dict(200)
response if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/vip\/window\/list\?/ then response.json.jq(`.data.list = []`)
response if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/vip\/web\/vip_center\/(v2|modules)/ then response.json.jq(`.data.benefits = [] | .data.welfare = null | .data.free_welfare = null | .data.draw_cards_welfare = null | .data.draw_cards_welfare_v2 = null`)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.viewunite\.v1\.View\/View$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.show\.v1\.Popular\/Index$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/bili_view_ad.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/bili_view_ad.js") with requires_body=true

[Mitm]
hostname = *bili*,api-pt.chuangyuejoy.com

