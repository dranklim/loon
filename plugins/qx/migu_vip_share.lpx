#!name = 咪咕视频
#!desc = 由 ZenmoFeiShi/Qx 的 migu_vip_share.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 0 条重写 + 2 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/migu.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 migu_vip_share.snippet
