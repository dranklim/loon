#!name = 咪咕视频
#!desc = 参考 ZenmoFeiShi 的去广告脚本：会员播放源解锁
#!author = dranklim, ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/migu.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 解锁会员播放源（*.miguvideo.com 播放接口）
#   · 修正 passport / 推送等接口的请求头
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 migu_vip_share.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/migu_vip_share.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
request if ${url} ~= /^https?:\/\/(play|play-pre|v|v[0-9]?-sc|vmesh|app-sc|vms-sc|display(-sc)?|common-sc|program-sc|d[0-9]-sc|fs-sc|fsdv-sc|mp-user|recommend-dy|chat|chat-wx|public-deliver[0-9]?|public-operbiz[0-9]?|public-img)\.miguvideo\.com\/.+/ then script("https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/migu_vip.js")
request if ${url} ~= /^https?:\/\/(passport|uem|push|jadeite|jadeiteapp|hound|feedback|rcsdk)\.migu\.cn\/.+/ then script("https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/migu_vip.js")

[Mitm]
hostname = *.miguvideo.com, *.migu.cn

