#!name = 腾讯体育净化
#!desc = 由 ZenmoFeiShi/Qx 的 txsports-ad-clean.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 0 条重写 + 7 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/txsports.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 txsports-ad-clean.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/txsports-ad-clean.snippet
#   原作者：TG@ZenMoFiShi / 怎么肥事（以 snippet 头部 #!author 为准）
#   该仓库未声明 LICENSE，版权归原作者；本插件仅做 QuantumultX → Loon 语法转换，
#   脚本镜像至本仓库 scripts/qx/ 以便国内直连。原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游 snippet 与脚本的 sha256
# ==========================================================================

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/txsports-ad-clean.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/txsports-ad-clean.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/txsports-ad-clean.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/txsports-ad-clean.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/txsports-ad-clean.js") with requires_body=true
response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/txsports-ad-clean.js") with requires_body=true
response if ${url} ~= /^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/txsports-ad-clean.js") with requires_body=true

[Mitm]
hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com

# ===== 转换告警（需人工复核）=====
#   ! 未识别行: ^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ (?i)\r\nUser-Agent:\s*QQ
