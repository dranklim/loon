#!name = TilingSales净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：开屏、浮窗、插屏与横幅广告
#!author = dranklim,ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/tilingsales.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 开屏广告（App/Ad/splashInfo）
#   · 首页浮窗与横幅（homeFloatAd / bannerInfo）
#   · 插屏与短剧广告（skitAdInfo）
#   · 弹窗计数、公告位与广告配置下发
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 TilingSales_ad_remove.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/TilingSales_ad_remove.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/splashInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/noticeInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/IndexList\/homeFloatAd/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/activityInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/skitAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/countPopTotal/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/barsUserAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/ad\/config/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/vajraInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/bannerInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/bardCacheAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/barsIndexAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/comicAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/liveEventAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/novelAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/sportAdInfo/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/CommentAd\/show/ then reject_dict(200)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/Config\/getNav/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/TilingSales_getNav.js") with requires_body=true
response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/barsPlayAdInfo/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/TilingSales_getNav.js") with requires_body=true
response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/playAdInfo/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/TilingSales_getNav.js") with requires_body=true
response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/IndexPlay\/vodAdvertisement/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/TilingSales_getNav.js") with requires_body=true
response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/Vod\/showOne/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/TilingSales_getNav.js") with requires_body=true
response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/Vod\/vurlDetail/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/TilingSales_getNav.js") with requires_body=true

[Mitm]
hostname = api.mxtxqe.com, api.sef5w7.com, sdapi.u4gdp3.com, sdapi.4zu76s.com, sdapi.re3k7n.com, api.xqe4cxu.com, api.syq8gvw.com, api.zjypp7x.com, apinew.n3yje.icu, apinew.8hpt2duq.com, apinew.fzmfbdmg.com, api.7gmsut2m.com, api.gq89em.com

