#!name = iTunes净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：内购收据校验拦截
#!author = dranklim, ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/xterm256.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 拦截 iTunes 收据校验（verifyReceipt），使应用按已购买处理
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 xTerm256.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/xTerm256.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
response if ${url} ~= /^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt/ then response.json.jq(`.receipt.in_app[].expires_date_ms = "4092599349000" | .latest_receipt_info[].expires_date_ms = "4092599349000" | .pending_renewal_info[].auto_renew_status = "1"`)

[Mitm]
hostname = buy.itunes.apple.com

