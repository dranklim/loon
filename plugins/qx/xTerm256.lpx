#!name = iTunes净化
#!desc = 由 ZenmoFeiShi/Qx 的 xTerm256.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 1 条重写 + 0 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/xterm256.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 xTerm256.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/xTerm256.snippet
#   原作者：TG@ZenMoFiShi / 怎么肥事（以 snippet 头部 #!author 为准）
#   该仓库未声明 LICENSE，版权归原作者；本插件仅做 QuantumultX → Loon 语法转换，
#   脚本镜像至本仓库 scripts/qx/ 以便国内直连。原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游 snippet 与脚本的 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
response if ${url} ~= /^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt/ then response.json.jq(`.receipt.in_app[].expires_date_ms = "4092599349000" | .latest_receipt_info[].expires_date_ms = "4092599349000" | .pending_renewal_info[].auto_renew_status = "1"`)

[Mitm]
hostname = buy.itunes.apple.com

