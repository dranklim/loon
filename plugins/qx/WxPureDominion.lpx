#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/mission\/api\/page\/activityInfo/ then reject_dict(200)
request if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/mission\/api\/page\/getPageDetail/ then reject_dict(200)
request if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/energy\/hummer\/api\/resource\/display/ then reject_dict(200)
request if ${url} ~= /^https:\/\/energy\.xiaojukeji\.com\/am\/marketing\/api\/member\/facade\/charge\/personal\/center/ then reject_dict(200)
request if ${url} ~= /^https:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/enterpriseWeChatConfig\/app\/queryCityConfig/ then reject_dict(200)
request if ${url} ~= /^https:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/appAdvertising\/queryAdvertisingByParams/ then reject_dict(200)
request if ${url} ~= /^https:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/charge\/activity\/package\/newest/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/wxorderextend\/banner\/get/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/wxorderextend\/banner\/get/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/xcxhomeapi\/aggregator\/index/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/mytourapi\/mytrip\/blankflight/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/membermessageuserapi\/message\/list/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/wechatmypubapi\/myInfo\/messageBox/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/membermessageuserapi\/category\/getCategory/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/homemarketapi\/search\/recommend/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/mytourapi\/blankpage\/recommendList/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/homemarketapi\/aggregator\/index/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/wxocbdapi\/adService\/getAd/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/homemarketapi\/aggregator\/index/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/xcxhomeapi\/home\/converge/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/platformpubapi\/customer\/lead\/getInfo/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/mytourapi\/mytrip\/toptips/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/vacation\/webapp\/tailor\/miniHomeConfig/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/wireless\/monitor\/wx\/common\/compressevent/ then reject_dict(200)
request if ${url} ~= /^https:\/\/wx\.17u\.cn\/wechatmypubapi\/myInfo\/listIcons/ then reject_dict(200)
request if ${url} ~= /^https:\/\/a1d5b283e-wx621112590b635086\.sh\.wxgateway\.com\/xcxhomeapi\/home\/screen/ then reject_dict(200)
request if ${url} ~= /^https:\/\/mapi\.dianping\.com\/baymax\/adrec\/getrecads/ then reject_dict(200)
request if ${url} ~= /^https:\/\/mapi\.dianping\.com\/baymax\/getSlotAds/ then reject_dict(200)
request if ${url} ~= /^https:\/\/web\.meituan\.com\/api\/miniprogram\/my\/novelZone/ then reject_dict(200)
request if ${url} ~= /^https:\/\/web\.meituan\.com\/api\/miniprogram\/my\/resources/ then reject_dict(200)
request if ${url} ~= /^https:\/\/npay\.meituan\.com\/conch\/flow\/mypage-wallet-info/ then reject_dict(200)
request if ${url} ~= /^https:\/\/web\.meituan\.com\/newUser\/returnMoney\/popWindow/ then reject_dict(200)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https:\/\/web\.meituan\.com\/api\/miniprogram\/tabbar\/all\/query/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MeiTuanNoAd.js") with requires_body=true
response if ${url} ~= /^https:\/\/web\.meituan\.com\/api\/miniprogram\/index\/aggregate/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/MeiTuanNoAd.js") with requires_body=true

[Mitm]
hostname = energy.xiaojukeji.com,gw3.ykccn.com,wx.17u.cn,web.meituan.com,npay.meituan.com,mapi.dianping.com,a1d5b283e-wx621112590b635086.sh.wxgateway.com,apimobile.meituan.com

