# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https:\/\/web\.meituan\.com\/api\/miniprogram\/tabbar\/all\/query/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/MeiTuanNoAd.js") with requires_body=true
response if ${url} ~= /^https:\/\/web\.meituan\.com\/api\/miniprogram\/index\/aggregate/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/MeiTuanNoAd.js") with requires_body=true

[Mitm]
hostname = energy.xiaojukeji.com,gw3.ykccn.com,wx.17u.cn,web.meituan.com,npay.meituan.com,mapi.dianping.com,a1d5b283e-wx621112590b635086.sh.wxgateway.com,apimobile.meituan.com

