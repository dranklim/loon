#!name = Soul净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：广场推荐、聊天引导与开屏运营位
#!author = dranklim,ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/soul.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 广场推荐与广告位（ssp/api/q）
#   · 聊天页快捷菜单、引导语与入口推荐
#   · 直播星球推荐列表
#   · 开屏与活动运营配置
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 Soul.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/Soul.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https:\/\/ssp\.soulapp\.cn\/api\/q/ then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu\/v2/ then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord/ then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/attach\/menu/ then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/entrance\/first/ then reject_dict(200)
request if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV2/ then reject(200)
response if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/v2\/post\/gift\/list/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/hot\/soul\/rank/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/gateway-mobile-gray\.soulapp\.cn\/mobile\/app\/version\/queryIos/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo/ then response.json.jq(`.data.limit = false`)
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/api-account\.soulapp\.cn\/teenager\/config/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module/ then response.json.jq(`.data = null`)
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList/ then response.json.jq(`.data.roomList = []`)
response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config/ then response.json.jq(`.data.gameInfo.gameCards |= map(select(.title != "异世界回响" and .title != "狼人魅影" and .title != "梦想海岛王" and .title != "幻想星球" and .title != "爆弹喵" and .title != "星球实验室" and .title != "兴趣群组" and .title != "群聊派对")) | .data.coreCards |= map(select(.title != "异世界回响" and .title != "狼人魅影" and .title != "梦想海岛王" and .title != "幻想星球" and .title != "爆弹喵" and .title != "星球实验室" and .title != "兴趣群组" and .title != "群聊派对") | if .secondCards then .secondCards |= map(select(.title != "异世界回响" and .title != "狼人魅影" and .title != "梦想海岛王" and .title != "幻想星球" and .title != "爆弹喵" and .title != "星球实验室" and .title != "兴趣群组" and .title != "群聊派对")) else . end | if .style == 2 then .style = 1 else . end)`)
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/v2\/post\/recSquare\/subTabs/ then response.json.jq(`.data |= map(select(.tabType == 7 or .tabType == 6 or .tabType == 2))`)

[Mitm]
hostname = api-account.soulapp.cn, chat-live.soulapp.cn, api-a.soulapp.cn, api-pay.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-chat.soulapp.cn, 120.55.55.115, 120.55.62.124, 121.196.203.183, 47.96.20.45, 47.98.54.106, 118.31.112.221, 8.210.3.170, 47.75.72.47, post.soulapp.cn, api-user.soulapp.cn, ssp.soulapp.cn, 47.110.187.87

