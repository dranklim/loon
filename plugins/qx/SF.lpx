#!name = 顺丰速运净化
#!desc = 由 ZenmoFeiShi/Qx 的 SF.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 4 条重写 + 0 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/sf.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

