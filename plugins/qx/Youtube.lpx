#!name = YouTube 去广告
#!desc = 由 ZenmoFeiShi/Qx 的 Youtube.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 5 条重写 + 1 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/youtube.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 Youtube.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/Youtube.snippet
#   原作者：TG@ZenMoFiShi / 怎么肥事（以 snippet 头部 #!author 为准）
#   该仓库未声明 LICENSE，版权归原作者；本插件仅做 QuantumultX → Loon 语法转换，
#   脚本镜像至本仓库 scripts/qx/ 以便国内直连。原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游 snippet 与脚本的 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?&ctier=L(&.+?),ctier,(.+)/ as m then redirect(302, "https://${m.1}${m.2}${m.3}")
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad/ then reject(200)
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads/ then reject(200)
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking)/ then reject(200)
request if ${url} ~= /^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext/ then reject(200)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/youtube.response.js") with requires_body=true

[Mitm]
hostname = *.googlevideo.com, redirector*.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com

