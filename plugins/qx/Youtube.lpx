#!name = YouTube净化
#!desc = 参考 ZenmoFeiShi 的去广告脚本：视频广告、首页 Shorts 与内嵌推荐卡
#!author = dranklim, ZenmoFeiShi
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/assets/youtube.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 本插件去除的内容
#   · 视频前贴片与中插广告（googlevideo / oad）
#   · 广告统计上报（stats/ads、pagead、qoe）
#   · 首页 Shorts 区块
#   · 播放页内嵌的购物与商品推荐卡
# ==========================================================================

# ==========================================================================
# 来源声明 / Attribution
#   去广告思路与规则参考开源项目 ZenmoFeiShi/Qx 的 Youtube.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/Youtube.snippet
#   原作者：TG@ZenMoFiShi、怎么肥事、walala（以 snippet 头部 #!author 为准）
#   上游未声明 LICENSE，版权归原作者所有；原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游构建日期与脚本 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?&ctier=L(&.+?),ctier,(.+)/ as m then redirect(302, "https://${m.1}${m.2}${m.3}")
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad/ then reject(200)
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads/ then reject(200)
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking)/ then reject(200)
request if ${url} ~= /^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext/ then reject(200)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)/ then script("https://raw.githubusercontent.com/dranklim/loon/main/scripts/qx/youtube.response.js") with requires_body=true

[Mitm]
hostname = *.googlevideo.com, redirector*.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com

