#!name = 黑料网净化
#!desc = 由 ZenmoFeiShi/Qx 的 hlwxx_remove_ads.snippet 转换为 Loon Rewrite/Script v2 语法（0 条规则 + 13 条重写 + 2 条脚本）
#!author = dranklim（转换）
#!homepage = https://github.com/dranklim/loon
#!icon = https://cdn.jsdelivr.net/gh/dranklim/loon@main/assets/hlwxx.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,净化
#!type = normal

# ==========================================================================
# 来源声明 / Attribution
#   规则与脚本源自开源项目 ZenmoFeiShi/Qx 的 hlwxx_remove_ads.snippet
#   https://github.com/ZenmoFeiShi/Qx/blob/main/hlwxx_remove_ads.snippet
#   原作者：TG@ZenMoFiShi / 怎么肥事（以 snippet 头部 #!author 为准）
#   该仓库未声明 LICENSE，版权归原作者；本插件仅做 QuantumultX → Loon 语法转换，
#   脚本镜像至本仓库 scripts/qx/ 以便国内直连。原作者有异议即行撤下。
#   同步：cron 任务 qx-suite-sync 每日比对上游 snippet 与脚本的 sha256
# ==========================================================================

# URL 重写（来自 QX url reject-* / jsonjq-response-body）
[Rewrite]
request if ${url} ~= /^https?:\/\/(?:www\.)?(?:heiliao|hlwxx|hlcx\d*)\.com\/(?!static\/|favicon|api\/|index\/statistics|uploads\/)/ then request.header.set("Accept-Encoding", "identity")
request if ${url} ~= /^https?:\/\/(?:www\.)?97baoliao\.com\/(?!usr\/|storage\/|api\/|favicon\.ico)/ then request.header.set("Accept-Encoding", "identity")
request if ${url} ~= /^https?:\/\/(?:www\.)?97baoliao\.com\/storage\/static\/popup-feed\.json(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:www\.)?97baoliao\.com\/usr\/plugins\/AiSuite\/assets\/js\/adfloat\.js(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/(?:www\.)?97baoliao\.com\/usr\/themes\/Mirages\/js\/7\.10\.0\/bottom_ad_poll\.js(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/stats\.kwvprfcr\.xyz/ then reject(404)
request if ${url} ~= /^https?:\/\/mc\.yandex\.ru/ then reject(404)
request if ${url} ~= /^https?:\/\/api1\.cghhqca\.cc\/api\/eventTracking/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.shuifeng\.cc\/api\/eventTracking/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/ads\.zyudkkup\.com\/api\/eventTracking/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/static\.cloudflareinsights\.com\/beacon/ then reject(404)
request if ${url} ~= /^https?:\/\/(?:www\.)?googletagmanager\.com\/(?:gtag\/js|gtm\.js)(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https?:\/\/(?:www\.)?google-analytics\.com\// then reject(404)

# 脚本处理（来自 QX url script-*，JS 已镜像至本仓库 scripts/qx/）
[Script]
response if ${url} ~= /^https?:\/\/(?:www\.)?(?:heiliao|hlwxx|hlcx\d*)\.com\/(?!static\/|favicon|api\/|index\/statistics|uploads\/)/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/hlwxx_remove_ads.js") with requires_body=true
response if ${url} ~= /^https?:\/\/(?:www\.)?97baoliao\.com\/(?!usr\/|storage\/|api\/|favicon\.ico)/ then script("https://cdn.jsdelivr.net/gh/dranklim/loon@main/scripts/qx/hlwxx_remove_ads.js") with requires_body=true

[Mitm]
hostname = *heiliao*, *hlwxx*, *hlcx*, *97baoliao*, stats.kwvprfcr.xyz, mc.yandex.ru, api1.cghhqca.cc, api.shuifeng.cc, ads.zyudkkup.com, static.cloudflareinsights.com, *.googletagmanager.com, *.google-analytics.com

