#!name = SkipProxy防检测
#!desc = 跳过部分应用的代理检测（银行/运营商 App 防 VPN 弹窗）。核心：REJECT 风控上报端点（农行 msmp + 平安口袋银行 IP 通道）+ skip-proxy/real-ip 直连名单。源自 mieqq/skip-proxy-lists.sgmodule，扩展平安口袋银行抓包分析（2026-08）
#!author = dranklim
#!homepage = https://github.com/dranklim/loon
#!system = iOS,iPadOS,tvOS
#!loon_version = 3.2.5
#!tag = 防检测,银行,直连
#!type = normal

[Rule]
# ===== 农行风控上报端点（实测解决"网络环境存在安全风险"弹窗）=====
# msmp = 农行移动安全管理平台。App 检测到 TUN/VPN 会向它上报，服务器回风险弹窗。
# REJECT 后上报失败 → 服务器收不到风险信号 → 不弹窗
DOMAIN,msmp.abchina.com.cn,REJECT

# ===== 平安口袋银行风控上报通道（IP 直连，绕域名规则，2026-08-19 抓包实锤）=====
# 45.65.23.16:8443/v3/report = 平安自有 AS23848 PINGANCOM（深圳），App 启动 5ms 即上报设备环境
# （含 VPN/utun 检测结果），Basic Auth + 加密 body。REJECT 后上报失败 → 服务器不判风险
IP-CIDR,45.65.23.16/32,REJECT

# ===== 平安口袋银行核心风控上报端点（IBP-SMP 安全平台，2026-08-19 二次抓包实锤）=====
# appmonlife = App 启动第一个请求（00:06:17.666），config 请求体含 nsi 网络状态上报
# （nt/dsi/dip 字段，TUN 接管后网关异常 → 服务器判 VPN）。服务器返回探针地址 pa + Net 检测开关
# REJECT 后 config 请求失败 → 服务器收不到网络状态 → 不判"您正在使用VPN"
DOMAIN,appmonlife.pingan.com.cn,REJECT
# 备用上报：logcloud-agent（服务器下发的日志云上报端点）
DOMAIN,logcloud-agent.pingan.com.cn,REJECT

# ===== 平安银行系全直连（防走代理导致出口 IP 境外）=====
DOMAIN-SUFFIX,pingan.com.cn,DIRECT
DOMAIN-SUFFIX,sdb.com.cn,DIRECT
DOMAIN-SUFFIX,orangebank.com.cn,DIRECT
DOMAIN-SUFFIX,jk.cn,DIRECT
DOMAIN-SUFFIX,1qianbao.com,DIRECT
DOMAIN-SUFFIX,yqbimg.net,DIRECT

[General]
# 以下域名跳过代理直连（银行/运营商 App 检测代理时白名单）
skip-proxy = www.baidu.com,yunbusiness.ccb.com,wxh.wo.cn,gate.lagou.com,www.abchina.com.cn,www.shanbay.com,login-service.mobile-bank.psbc.com,mobile-bank.psbc.com,id6.me,www.163.com,pingan.com.cn,sdb.com.cn,orangebank.com.cn
# 以下域名始终返回真实 IP（不参与 Fake IP，防 App 检测到 198.18.x.x 保留段）
real-ip = easy-login.10099.com.cn,*-update.xoyocdn.com,id6.me,open.e.189.cn,cdn.sdb.com.cn

# ===== 域名注释 =====
# www.baidu.com：网上国网、多看阅读、顺丰金融、广东农信、丰云行、中国银行缤纷生活、通信行程卡、趣智校园、光大手机银行、掌上12333、沃视频
# yunbusiness.ccb.com 建行生活
# wxh.wo.cn 沃小号
# gate.lagou.com 拉勾招聘
# www.abchina.com.cn 中国农业银行
# www.shanbay.com 扇贝单词消息中心
# login-service.mobile-bank.psbc.com / mobile-bank.psbc.com 中国邮政储蓄银行
# easy-login.10099.com.cn 中国广电
# id6.me 中国电信一键登录
# www.163.com 交管12123
# *-update.xoyocdn.com 剑网三无界
# ===== 平安口袋银行（2026-08-19 新增）=====
# pingan.com.cn / sdb.com.cn / orangebank.com.cn / jk.cn / 1qianbao.com / yqbimg.net 平安系全直连
# cdn.sdb.com.cn 含 dns_detect.png（DNS 劫持检测探针），必须 real-ip 防 Fake IP 误判
