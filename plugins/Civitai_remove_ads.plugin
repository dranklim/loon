#!name = Civitai去广告
#!desc = civitai.red 去广告（Snigel AdNgin / Google Ad Manager / AnyClip / GTM / 自营打点）
#!author = dranklim
#!homepage = https://github.com/dranklim/loon
#!system = iOS,iPadOS,tvOS
#!loon_version = 3.2.5
#!tag = 去广告
#!type = normal

[Rule]
# ===== Snigel AdNgin 主广告引擎（核心，实测 cdn.snigelweb.com/adengine/civitai.com/loader.js 200）=====
DOMAIN-SUFFIX,snigelweb.com,REJECT
# ===== Google 广告与埋点 =====
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,adsbygoogle.com,REJECT
# ===== AnyClip outstream 视频广告 =====
DOMAIN-SUFFIX,anyclip.com,REJECT
# ===== Civitai 自营广告曝光打点（保留 API，仅拦打点路径）=====
URL-REGEX,^https?:\/\/civitai\.red\/api\/v1\/view,REJECT
URL-REGEX,^https?:\/\/civitai\.com\/api\/v1\/view,REJECT
