#!name = 懂球帝去广告
#!desc = 基于抓包分析(360_1785518464491.har)的懂球帝去广告：规则层拦截广告服务器(dab.dongdianqiu.com 追踪/曝光/点击、京东广告SDK)，脚本层清理评论区(role=ad_dplus 广告位)和详情页(dqd_ads 广告位)
#!author = dranklim
#!homepage = https://github.com/dranklim/loon
#!icon = https://raw.githubusercontent.com/dranklim/loon/main/plugins/icon.png
#!system = iOS,iPadOS,tvOS
#!loon_version = 3.2.5
#!tag = 去广告,懂球帝,抓包
#!type = normal

[Rule]
# 懂球帝广告服务器（track 追踪 / imp 曝光 / click 点击）
DOMAIN-SUFFIX,dab.dongdianqiu.com,REJECT
# 京东广告 SDK 日志上报
DOMAIN-SUFFIX,uranus.jd.com,REJECT
# 京东引流广告 API（appid=yinliu）
URL-REGEX,^https?:\/\/api\.m\.jd\.com\/\?appid=yinliu,REJECT

[Script]
http-response ^https?:\/\/(api\.dongdianqiu\.com\/v2\/article\/\d+\/comment|detail\.dongdianqiu\.com\/v2\/article\/detail\/\d+) script-path=https://raw.githubusercontent.com/dranklim/loon/main/plugins/dqd_ad.js, requires-body=true, timeout=60, tag=dqd_ad
